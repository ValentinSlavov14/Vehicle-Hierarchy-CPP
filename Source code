#include <iostream>
#include <string>

using namespace std;

class Vehicle {
protected:
    string brand;
    double price;
public:
    
    Vehicle() {
        brand = "Generic";
        price = 1000.0;
    }
    
    Vehicle(string b, double p = 2000.0) {
        brand = b;
        price = p;
    }
    
    virtual ~Vehicle() {}
    
    virtual void printInfo() const = 0;


    void applyVat() {
        price = price + (price * 0.20);
        cout << "VAT applied. New price for " << brand << ": " << price << endl;
    }

 
    void registerVehicle(double tax) {
        price += tax;
    }
};

class LandVehicle : virtual public Vehicle {
protected:
    int wheels;
    double fuel;
public:
    LandVehicle() : Vehicle() {
        wheels = 4;
        fuel = 50.0;
    }
    LandVehicle(string b, double p, int w = 4, double f = 40.0) : Vehicle(b, p) {
        wheels = w;
        fuel = f;
    }
    void printInfo() const override {
        cout << "Brand: " << brand << " | Price: " << price << " | Wheels: " << wheels << " | Fuel: " << fuel << "L";
    }

    
    void drive(double km) {
        double consumed = km / 10.0;
        fuel -= consumed;
        if (fuel < 0) fuel = 0;
        cout << brand << " drove " << km << "km. Consumed: " << consumed << "L." << endl;
    }

    void refuel(double liters) {
        fuel += liters;
    }
};

class AirVehicle : public Vehicle {
protected:
    double altitude;
    int engines;
public:
    AirVehicle() : Vehicle() {
        altitude = 0.0;
        engines = 1;
    }
    AirVehicle(string b, double p, double a = 0.0, int e = 2) : Vehicle(b, p) {
        altitude = a;
        engines = e;
    }
    void printInfo() const override {
        cout << "Brand: " << brand << " | Price: " << price << " | Alt: " << altitude << "m";
    }

    void takeOff(double targetAlt) {
        altitude = targetAlt;
        cout << brand << " took off to " << altitude << "m." << endl;
    }

    void serviceEngines() {
        price += (engines * 1000.0);
    }
};

class Car : virtual public LandVehicle {
protected:
    int seats;
    double engineVol;
public:
    Car() : LandVehicle() {
        seats = 5;
        engineVol = 1.6;
    }
    Car(string b, double p, int s = 5, double ev = 2.0) : Vehicle(b, p), LandVehicle(b, p) {
        seats = s;
        engineVol = ev;
    }
    void printInfo() const override {
        LandVehicle::printInfo();
        cout << " | Seats: " << seats << " | Eng: " << engineVol;
    }

    void washCar() {
        price += 20.0;
        cout << "Car is now clean. Value increased." << endl;
    }

    void addSeat() {
        seats++;
    }
};

class Truck : virtual public LandVehicle {
protected:
    double cargoWeight; 
    int axles;
public:
    Truck() : LandVehicle() {
        cargoWeight = 0.0;
        axles = 2;
    }
    Truck(string b, double p, double cw = 0.0, int ax = 3) : Vehicle(b, p), LandVehicle(b, p) {
        cargoWeight = cw;
        axles = ax;
    }
    void printInfo() const override {
        LandVehicle::printInfo();
        cout << " | Cargo: " << cargoWeight << "t | Axles: " << axles;
    }

    
    void loadCargo(double weight) {
        cargoWeight += weight;
        cout << "Loaded " << weight << "t. Total cargo: " << cargoWeight << "t." << endl;
    }

    void addAxle() {
        axles++;
        wheels += 2;
    }
};

class Plane : public AirVehicle {
private:
    double wingspan;
    int passengers;
public:
    Plane() : AirVehicle() {
        wingspan = 30.0;
        passengers = 0;
    }
    Plane(string b, double p, double w = 65.5, int pass = 0) : AirVehicle(b, p) {
        wingspan = w;
        passengers = pass;
    }
    void printInfo() const override {
        AirVehicle::printInfo();
        cout << " | Wing: " << wingspan << "m | Passengers: " << passengers;
    }

    
    void boardPassengers(int count) {
        passengers += count;
        cout << count << " passengers boarded the plane." << endl;
    }

    void upgradeWings(double extra) {
        wingspan += extra;
    }
};

class ElectricCar : public Car, public Truck {
private:
    double battery;
    double charge;
public:
    ElectricCar() : Car(), Truck() {
        battery = 75.0;
        charge = 100.0;
    }
    ElectricCar(string b, double p, double batt = 100.0, double ch = 50.0)
        : Vehicle(b, p), LandVehicle(b, p), Car(b, p), Truck(b, p) {
        battery = batt;
        charge = ch;
    }
    void printInfo() const override {
        Car::printInfo();
        cout << " | Batt: " << battery << "kWh | Charge: " << charge << "%";
    }

   
    void chargeBattery(double amount) {
        charge += amount;
        if (charge > 100) charge = 100;
        cout << brand << " charging... Current charge: " << charge << "%" << endl;
    }

    void degradeBattery() {
        battery -= 1.0;
    }
};

int main() {
    Vehicle* elements[] = {
        new Car("Toyota", 30000, 5, 1.8),
        new Truck("MAN", 90000, 5.0, 2),
        new Plane("Cessna", 500000, 15.0, 4),
        new ElectricCar("Tesla Truck", 100000, 100, 20)
    };

    for (auto e : elements) {
        if (e == nullptr) continue;

        cout << "--- Initial Info ---" << endl;
        e->printInfo();
        cout << endl;

        
        e->applyVat(); 

        if (ElectricCar* ec = dynamic_cast<ElectricCar*>(e)) {
            ec->chargeBattery(30); 
        }
        else if (Plane* p = dynamic_cast<Plane*>(e)) {
            p->boardPassengers(150); 
            p->takeOff(10000);
        }
        else if (Truck* t = dynamic_cast<Truck*>(e)) {
            t->loadCargo(10); 
            t->drive(50); 
        }
        else if (Car* c = dynamic_cast<Car*>(e)) {
            c->washCar(); 
            c->drive(100);
        }

        cout << "--- Updated Info ---" << endl;
        e->printInfo();
        cout << endl << "------------------------------------" << endl;
    }

    for (auto e : elements) delete e;
    return 0;
}
